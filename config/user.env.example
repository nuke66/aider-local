# User-level Aider config for LM Studio (installed to %USERPROFILE%\.aider\aider.env)
# Edit model names to match what you load in LM Studio.

AIDER_MODEL=lm_studio/google/gemma-4-26b-a4b
AIDER_WEAK_MODEL=lm_studio/google/gemma-4-e4b
AIDER_STREAM=true
LM_STUDIO_API_KEY=dummy-api-key
LM_STUDIO_API_BASE=http://localhost:1234/v1
